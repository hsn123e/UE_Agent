# OpenAI-compatible endpoint (OpenAI / OpenRouter / LM Studio / vLLM / ...)
LLM_BASE_URL=http://localhost:1234
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4.1-mini

# Remote Control (Unreal)
# Prefer setting one of the following:
# UE_RC_PORT=30010
# UE_RC_PORT_FILE=C:\\path\\to\\rc_server_port.txt
UE_RC_PORT=
UE_RC_PORT_FILE=

# UE Agent Bridge (Unreal plugin)
UE_BRIDGE_PORT=30020
UE_BRIDGE_TOKEN=
UE_BRIDGE_ENABLE=1

# Agent server
AGENT_HOST=127.0.0.1
AGENT_PORT=32123

# MCP (optional)
# MCP_ENABLE=1
# MCP_CONFIG_PATH=C:\\path\\to\\.mcp-config.json
MCP_ENABLE=
MCP_CONFIG_PATH=
